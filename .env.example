# ═══════════════════════════════════════════════════════════════
# AI TEAM SYSTEM — Конфигурация
# Скопируй в .env и заполни только нужные блоки
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# ЛОКАЛЬНО (работает без интернета и без ключей)
# Модели по профилям железа: light → qwen3:4b, medium → qwen3:8b, heavy → qwen3:14b
# ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─────────────────────────────────────────────────────────────
# РЕЖИМ И ЖЕЛЕЗО
#   AI_MODE=local — сначала локальная модель, облако только как подстраховка
#   AI_MODE=cloud — сначала облачный провайдер
# ─────────────────────────────────────────────────────────────
AI_MODE=local
HARDWARE_PROFILE=medium

# ─────────────────────────────────────────────────────────────
# УНИВЕРСАЛЬНЫЙ OpenAI-СОВМЕСТИМЫЙ ЭНДПОИНТ (провайдер openai_compat)
# Подходит для агрегаторов, работающих с РФ (ProxyAPI, VseGPT и др.),
# и для self-hosted шлюзов вроде OmniRoute: указываешь адрес, ключ и модель.
# Значения задаются в этом файле, в коде их нет.
# ─────────────────────────────────────────────────────────────
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_LABEL=

# ─────────────────────────────────────────────────────────────
# OMNIROUTE (локальный шлюз, если поднят: npm i -g omniroute)
# ─────────────────────────────────────────────────────────────
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# ─────────────────────────────────────────────────────────────
# ОБЛАЧНЫЕ ПРОВАЙДЕРЫ (опционально, включаются наличием ключа)
# OpenRouter с 27.06.2026 не обслуживает российские аккаунты и IP —
# ключ имеет смысл только за пределами РФ.
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_STUDIO_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub Models — бесплатный vision-анализ скриншотов (лимит запросов в день)
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────
# ПРОЧЕЕ
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DB_PATH=./data/ai_team.db
PROJECTS_DIR=~/projects
SECRET_KEY=
